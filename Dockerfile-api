# Utilisation de Python 3.10
FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Définition du dossier de travail
WORKDIR /app

# 1. Installation des dépendances Python
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
RUN pip install --no-cache-dir gdown

# 2. Copie du code source
COPY app/ ./app
COPY main.py .

# Création du dossier models
RUN mkdir -p models

# =========================================================
# 3. TÉLÉCHARGEMENT DES MODÈLES DEPUIS GOOGLE DRIVE
# =========================================================

# --- PARTIE 1 & 2 : Vision & OOD ---
RUN gdown --id 1LIad0Gvsvi1ikBe7eO8LzBt2rAcxYS7N -O models/vision_weights.pth
RUN gdown --id 18q_qfJKL9rWsmMuhP23r3PMOxodPteYo -O models/ood_detector.joblib

# --- PARTIE 3 : NLP (DistilBERT) ---
RUN gdown --id 14wOsDyYa5m8TETauasZSFZdchNER8qaY -O models/part3_nlp_weights.pth
RUN gdown --id 1i7bbms05XamcHxhOLKyd6AogATaPoqEe -O models/part3_classes.json

# --- PARTIE 4 : RAG (Qwen/CLIP/Annoy) ---
RUN gdown --id 1UNxHtKq-_YduxbxcgNvWHvHuyyF7Onfl -O models/part4_rag_index.ann
RUN gdown --id 1TLxhvUa2IX0tWuYGYvH-9F-2Wgi2NakM -O models/part4_rag_brochure.pkl
RUN gdown --id 1u8lshUFW7KCy1PBNe_DqcXcmC0Y6xn4z -O models/part4_rag_map.json

# =========================================================

# 4. Configuration Environnement
ENV PYTHONPATH=/app
ENV HF_HUB_OFFLINE=0 
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python", "main.py"]